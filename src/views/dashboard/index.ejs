<%
const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
}[character]));
%>
<%- include('../layouts/app-shell', {
  title: 'Home',
  body: `
    <section class="panel-card mb-3">
      <h2 class="section-title mb-2">Home operativo</h2>
      <p class="mb-0">Bienvenido, ${escapeHtml(user?.fullName || 'Usuario')}. Desde aqui puedes controlar compras, stock y seguridad de la plataforma.</p>
    </section>

    <section class="dashboard-grid mb-3">
      ${canNavigate('ventas:view') ? `<article class="stat-card">
        <h3>Ventas</h3>
        <p>Registra ventas y mantiene actualizado el stock de tu sucursal.</p>
        <a href="/ventas" class="btn btn-sm btn-outline-light">Ir a ventas</a>
      </article>` : ''}
      ${(supportMode || user?.subscriptionPlan === 'PREMIUM') && canNavigate('compras:view') ? `<article class="stat-card">
        <h3>Compras</h3>
        <p>Visualiza ordenes y su estado en tiempo real.</p>
        <a href="/compras" class="btn btn-sm btn-outline-light">Ir a compras</a>
      </article>` : ''}
      ${canNavigate('stock:view') ? `<article class="stat-card">
        <h3>Stock</h3>
        <p>Consulta niveles actuales y ultimos movimientos.</p>
        <a href="/stock" class="btn btn-sm btn-outline-light">Ir a stock</a>
      </article>` : ''}
      ${(supportMode || user?.subscriptionPlan === 'PREMIUM' || user?.role === 'ADMIN') && canNavigate('seguridad:view') ? `<article class="stat-card">
        <h3>Seguridad</h3>
        <p>Consulta y gestiona la seguridad de tu empresa.</p>
        <a href="/seguridad/usuarios" class="btn btn-sm btn-outline-light">Ir a seguridad</a>
      </article>` : ''}
    </section>

    <section class="panel-card">
      <h3 class="section-title mb-2">Resumen de sesion</h3>
      <div class="row g-2">
        <div class="col-md-4"><span class="status-pill">Usuario: ${escapeHtml(user?.fullName || '-')}</span></div>
        <div class="col-md-4"><span class="status-pill">Rol: ${escapeHtml(user?.role || '-')}</span></div>
        <div class="col-md-4"><span class="status-pill">Estado: Activo</span></div>
      </div>
    </section>
  `
}) %>
