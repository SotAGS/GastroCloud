<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Soporte | GastroCloud</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="login-body">
    <main class="container py-4">
      <section class="panel-card mb-3">
        <h1>Soporte GastroCloud</h1>
        <p>Hola, <%= user.fullName %>. El acceso a las empresas es de solo lectura y queda registrado.</p>
        <form method="post" action="/auth/logout"><button class="btn btn-outline-light">Cerrar sesión</button></form>
      </section>
      <section class="panel-card mb-3">
        <h2>Empresas</h2>
        <% if (!companies.length) { %><p>No hay empresas disponibles.</p><% } %>
        <% companies.forEach((company) => { %>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span><%= company.name %><%= company.isActive ? '' : ' (inactiva)' %></span>
            <form method="post" action="/soporte/acceder/<%= company.id %>">
              <button class="btn btn-light">Acceder</button>
            </form>
          </div>
        <% }) %>
      </section>
      <% if (canManageSupport) { %>
        <section class="panel-card">
          <h2>Cuentas de soporte</h2>
          <ul><% accounts.forEach((account) => { %><li><%= account.user.username %><%= account.canManageSupport ? ' (administrador)' : '' %></li><% }) %></ul>
          <form method="post" action="/soporte/cuentas" class="login-form">
            <label>Nombre <input class="form-control" name="fullName" maxlength="120" required /></label>
            <label>Usuario <input class="form-control" name="username" maxlength="50" required /></label>
            <label>Correo <input class="form-control" type="email" name="email" maxlength="120" required /></label>
            <label>Contraseña inicial <input class="form-control" type="password" name="password" minlength="12" maxlength="72" required /></label>
            <button class="btn btn-light">Crear soporte</button>
          </form>
        </section>
      <% } %>
    </main>
  </body>
</html>
