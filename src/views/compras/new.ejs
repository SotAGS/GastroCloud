<%
const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({
  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
}[character]));
const supplierOptions = (suppliers || []).map((supplier) =>
  `<option value="${escapeHtml(supplier.id)}">${escapeHtml(supplier.businessName)}</option>`
).join('');
const productOptions = (products || []).map((product) =>
  `<option value="${escapeHtml(product.id)}">${escapeHtml(product.name)} (${escapeHtml(product.unit)})</option>`
).join('');
const today = new Date().toISOString().slice(0, 10);
%>
<%- include('../layouts/app-shell', {
  title: 'Nueva compra',
  body: `
    <section class="panel-card">
      <h2 class="section-title mb-3">Registrar compra</h2>
      ${
        !suppliers.length || !products.length
          ? `<p class="alert alert-info">${!suppliers.length ? 'Primero debes crear un proveedor activo. ' : ''}${!products.length ? 'No hay productos activos para esta sucursal.' : ''}</p>`
          : `
            <form method="post" action="/compras">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Proveedor</label>
                  <select class="form-select" name="supplierId" required>
                    <option value="">Seleccionar proveedor</option>${supplierOptions}
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Fecha</label>
                  <input class="form-control" type="date" name="purchaseDate" value="${today}" required />
                </div>
                <div class="col-12">
                  <label class="form-label">Observaciones</label>
                  <input class="form-control" name="observations" maxlength="300" />
                </div>
              </div>
              <h3 class="section-title h5 mt-4">Productos</h3>
              <div id="purchase-lines">
                <div class="row g-2 align-items-end mb-3 purchase-line">
                  <div class="col-md-6">
                    <label class="form-label">Producto</label>
                    <select class="form-select" name="details[0][productId]" required>
                      <option value="">Seleccionar producto</option>${productOptions}
                    </select>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label">Cantidad</label>
                    <input class="form-control" type="number" step="0.001" min="0.001" name="details[0][quantity]" required />
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Costo unitario</label>
                    <input class="form-control" type="number" step="0.01" min="0" name="details[0][unitCost]" required />
                  </div>
                </div>
              </div>
              <template id="purchase-line-template">
                <div class="row g-2 align-items-end mb-3 purchase-line">
                  <div class="col-md-6">
                    <label class="form-label">Producto</label>
                    <select class="form-select" name="details[__INDEX__][productId]">
                      <option value="">Seleccionar producto</option>${productOptions}
                    </select>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label">Cantidad</label>
                    <input class="form-control" type="number" step="0.001" min="0.001" name="details[__INDEX__][quantity]" />
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Costo unitario</label>
                    <input class="form-control" type="number" step="0.01" min="0" name="details[__INDEX__][unitCost]" />
                  </div>
                  <div class="col-md-1">
                    <button class="btn btn-outline-danger remove-purchase-line" type="button" aria-label="Quitar producto">×</button>
                  </div>
                </div>
              </template>
              <div class="d-flex gap-2 mt-3">
                <button id="add-purchase-line" class="btn btn-outline-light" type="button">Agregar producto</button>
                <button class="btn btn-light" type="submit">Guardar compra</button>
              </div>
            </form>
            <script>
              (function () {
                var nextIndex = 1;
                var lines = document.getElementById('purchase-lines');
                var template = document.getElementById('purchase-line-template');
                document.getElementById('add-purchase-line').addEventListener('click', function () {
                  lines.insertAdjacentHTML('beforeend', template.innerHTML.replace(/__INDEX__/g, String(nextIndex++)));
                });
                lines.addEventListener('click', function (event) {
                  if (event.target.closest('.remove-purchase-line')) event.target.closest('.purchase-line').remove();
                });
              })();
            </script>
          `
      }
    </section>
  `
}) %>
