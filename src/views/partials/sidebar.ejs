<aside class="sidebar">
  <div class="brand-block">
    <div class="brand-mark">GC</div>
    <div>
      <p class="brand-title">GastroCloud</p>
      <p class="brand-subtitle"><%= user?.subscriptionPlan || 'PREMIUM' %></p>
    </div>
  </div>
  <nav class="menu-nav">
    <% if (canNavigate('dashboard:view')) { %><a href="/dashboard">Dashboard</a><% } %>
    <% if (canNavigate('ventas:view')) { %><a href="/ventas">Ventas</a><% } %>
    <% if (canNavigate('stock:view')) { %><a href="/stock">Stock</a><% } %>
    <% if ((supportMode || user?.subscriptionPlan === 'PREMIUM') && canNavigate('compras:view')) { %>
      <a href="/compras">Compras</a>
    <% } %>
    <% if (supportMode || user?.subscriptionPlan === 'PREMIUM') { %>
      <a href="/ia/chat">Asistente IA</a>
    <% } %>
    <% if (canNavigate('catalog:read')) { %>
      <a href="/catalogo/productos">Catálogo</a>
    <% } %>
    <% if ((supportMode || user?.subscriptionPlan === 'PREMIUM') && canNavigate('reportes:view')) { %>
      <a href="/reportes">Reportes</a>
    <% } %>
    <% if (canNavigate('reportes:view')) { %>
      <a href="/reportes/soporte">Actividad de soporte</a>
    <% } %>
    <% if ((supportMode || user?.subscriptionPlan === 'PREMIUM' || user?.role === 'ADMIN') && canNavigate('seguridad:view')) { %>
      <a href="/seguridad/usuarios">Seguridad y roles</a>
    <% } %>
    <% if (user?.role === 'ADMIN' && !supportMode) { %>
      <% if (!isProduction) { %><a href="/planes">Mi plan</a><% } %>
      <a href="/empresa">Mi empresa</a>
    <% } %>
  </nav>
</aside>
