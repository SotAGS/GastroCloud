<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Asistente IA | GastroCloud</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body>
    <div class="app-grid">
      <%- include('../partials/sidebar') %>
      <div class="content-panel">
        <%- include('../partials/navbar') %>
        <main class="content-main">
          <div class="panel-card ai-chat-shell">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div>
                <p class="text-uppercase text-muted small mb-1">Asistente IA</p>
                <h2 class="section-title">Consultas del negocio</h2>
              </div>
              <span class="status-pill">Premium</span>
            </div>

            <p class="text-light-emphasis mb-4">
              Este asistente solo puede responder con el contexto del negocio actual y nunca con información de otras empresas, del código de GastroCloud ni de otros sistemas.
            </p>

            <form method="post" action="/ia/chat" class="ai-chat-form">
              <textarea name="question" class="form-control" rows="4" placeholder="Ejemplo: ¿Qué productos tienen stock bajo?" required><%= question || '' %></textarea>
              <button type="submit" class="btn btn-light mt-3">Consultar IA</button>
            </form>

            <% if (error) { %>
              <div class="alert alert-danger mt-3 mb-0" role="alert"><%= error %></div>
            <% } %>

            <% if (answer) { %>
              <div class="ai-response mt-4">
                <h3 class="h6 text-uppercase text-muted">Respuesta</h3>
                <p class="mb-0"><%= answer %></p>
              </div>
            <% } %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
