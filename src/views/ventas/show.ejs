<%
const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;',
  "'": '&#39;',
}[character]));
%>
<%- include('../layouts/app-shell', {
  title: 'Detalle de venta',
  body: `
    <section class="panel-card">
      <h2 class="section-title">Venta ${escapeHtml(sale.saleNumber)}</h2>
      <p>Fecha: ${new Date(sale.soldAt).toLocaleString('es-AR')}</p>
      <p>Estado: <span class="status-pill">${sale.status}</span></p>
      <p>Total: $ ${Number(sale.total).toFixed(2)}</p>

      <h4 class="mt-4">Productos</h4>
      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Cantidad</th>
              <th>Precio unitario</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            ${(sale.details || [])
              .map(
                (detail) => `
                  <tr>
                    <td>${escapeHtml(detail.product?.name || detail.productId)}</td>
                    <td>${Number(detail.quantity).toFixed(3)}</td>
                    <td>$ ${Number(detail.unitPrice).toFixed(2)}</td>
                    <td>$ ${Number(detail.lineTotal).toFixed(2)}</td>
                  </tr>
                `,
              )
              .join('')}
          </tbody>
        </table>
      </div>
      ${
        sale.status === 'CANCELLED' && sale.cancelledAt
          ? `<p class="text-warning">Anulada: ${new Date(sale.cancelledAt).toLocaleString('es-AR')}</p>`
          : ''
      }
      ${
        sale.status === 'COMPLETED' && user?.role === 'ADMIN'
          ? `
            <form method="post" action="/ventas/${sale.id}/anular" class="mt-3">
              <button class="btn btn-outline-danger" type="submit">Anular y devolver al stock</button>
            </form>
          `
          : ''
      }
    </section>
  `
}) %>
