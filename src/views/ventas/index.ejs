<%- include('../layouts/app-shell', {
  title: 'Ventas',
  body: `
    <section class="panel-card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-title">Ventas</h2>
        <a href="/ventas/nueva" class="btn btn-light">Nueva venta</a>
      </div>
      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
          <thead>
            <tr>
              <th>Nro</th>
              <th>Fecha</th>
              <th>Estado</th>
              <th>Productos</th>
              <th>Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            ${(sales || [])
              .map(
                (sale) => `
                  <tr>
                    <td>${sale.saleNumber}</td>
                    <td>${new Date(sale.soldAt).toLocaleString('es-AR')}</td>
                    <td><span class="status-pill">${sale.status}</span></td>
                    <td>${sale.details?.length || 0}</td>
                    <td>$ ${Number(sale.total).toFixed(2)}</td>
                    <td><a href="/ventas/${sale.id}" class="btn btn-sm btn-outline-light">Ver</a></td>
                  </tr>
                `,
              )
              .join('')}
          </tbody>
        </table>
      </div>
    </section>
  `
}) %>
