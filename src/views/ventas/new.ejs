<%
const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;',
  "'": '&#39;',
}[character]));
const productOptions = (products || []).map((product) => {
  const quantity = Number(product.stocks?.[0]?.currentQuantity || 0);
  return '<option value="' + escapeHtml(product.id) + '" data-price="' + Number(product.salePrice).toFixed(2) + '">' + escapeHtml(product.name) + ' — disponible: ' + quantity.toFixed(3) + '</option>';
}).join('');
%>
<%- include('../layouts/app-shell', {
  title: 'Nueva venta',
  body: `
    <section class="panel-card">
      <h2 class="section-title mb-2">Registrar venta</h2>
      <p class="mb-3">Solo se pueden elegir productos con stock positivo. El inventario se vuelve a validar al confirmar.</p>
      ${
        products.length === 0
          ? '<p class="alert alert-info">No hay productos con stock disponible en esta sucursal.</p>'
          : `
            <form method="post" action="/ventas">
              <div id="sale-lines">
                <div class="row g-2 align-items-end mb-3 sale-line">
                  <div class="col-md-5">
                    <label class="form-label">Producto</label>
                    <select class="form-select" name="details[0][productId]" required>
                      <option value="">Seleccionar producto</option>
                      ${productOptions}
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Cantidad</label>
                    <input class="form-control" type="number" step="0.001" min="0.001" name="details[0][quantity]" required />
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Precio unitario</label>
                    <input class="form-control" type="number" step="0.01" min="0" name="details[0][unitPrice]" readonly required />
                  </div>
                </div>
              </div>
              <template id="sale-line-template">
                <div class="row g-2 align-items-end mb-3 sale-line">
                  <div class="col-md-5">
                    <label class="form-label">Producto</label>
                    <select class="form-select" name="details[__INDEX__][productId]">
                      <option value="">Seleccionar producto</option>
                      ${productOptions}
                    </select>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Cantidad</label>
                    <input class="form-control" type="number" step="0.001" min="0.001" name="details[__INDEX__][quantity]" />
                  </div>
                  <div class="col-md-3">
                    <label class="form-label">Precio unitario</label>
                    <input class="form-control" type="number" step="0.01" min="0" name="details[__INDEX__][unitPrice]" readonly />
                  </div>
                  <div class="col-md-1">
                    <button class="btn btn-outline-danger remove-sale-line" type="button" aria-label="Quitar producto">×</button>
                  </div>
                </div>
              </template>
              <div class="d-flex gap-2 mt-3">
                <button id="add-sale-line" class="btn btn-outline-light" type="button">Agregar producto</button>
                <button class="btn btn-light" type="submit">Confirmar venta</button>
              </div>
            </form>
            <script>
              (function () {
                var nextIndex = 1;
                var lines = document.getElementById('sale-lines');
                var template = document.getElementById('sale-line-template');
                document.getElementById('add-sale-line').addEventListener('click', function () {
                  lines.insertAdjacentHTML('beforeend', template.innerHTML.replace(/__INDEX__/g, String(nextIndex++)));
                });
                lines.addEventListener('click', function (event) {
                  if (event.target.closest('.remove-sale-line')) event.target.closest('.sale-line').remove();
                });
                lines.addEventListener('change', function (event) {
                  if (event.target.matches('select[name$="[productId]"]')) {
                    var option = event.target.selectedOptions[0];
                    var price = event.target.closest('.sale-line').querySelector('input[name$="[unitPrice]"]');
                    price.value = option.dataset.price || '';
                  }
                });
              })();
            </script>
          `
      }
    </section>
  `
}) %>
