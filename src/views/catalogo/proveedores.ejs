<%
const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({
  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
}[character]));
%>
<%- include('../layouts/app-shell', {
  title: 'Proveedores',
  body: `
    <section class="panel-card">
      <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="section-title">Proveedores de la empresa</h2><a class="btn btn-sm btn-outline-light" href="/catalogo/productos">Productos</a></div>
      <form method="post" action="/catalogo/proveedores" class="row g-2 mb-4">
        <div class="col-md-3"><label class="form-label">Razón social</label><input class="form-control" name="businessName" maxlength="150" required /></div>
        <div class="col-md-2"><label class="form-label">CUIT / ID fiscal</label><input class="form-control" name="taxId" maxlength="30" /></div>
        <div class="col-md-2"><label class="form-label">Email</label><input class="form-control" type="email" name="email" maxlength="120" /></div>
        <div class="col-md-2"><label class="form-label">Teléfono</label><input class="form-control" name="phone" maxlength="30" /></div>
        <div class="col-md-2"><label class="form-label">Dirección</label><input class="form-control" name="address" maxlength="200" /></div>
        <div class="col-md-1 d-flex align-items-end"><button class="btn btn-light" type="submit">Crear</button></div>
      </form>
      <div class="table-responsive"><table class="table table-dark table-hover align-middle">
        <thead><tr><th>Razón social</th><th>CUIT / ID fiscal</th><th>Email</th><th>Teléfono</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>${(suppliers || []).map((supplier) => {
          const id = escapeHtml(supplier.id);
          return `<tr>
            <td>${escapeHtml(supplier.businessName)}</td><td>${escapeHtml(supplier.taxId || '—')}</td><td>${escapeHtml(supplier.email || '—')}</td><td>${escapeHtml(supplier.phone || '—')}</td>
            <td><span class="status-pill">${supplier.isActive ? 'Activo' : 'Inactivo'}</span></td>
            <td><details><summary class="btn btn-sm btn-outline-light">Editar</summary>
              <form method="post" action="/catalogo/proveedores/${id}" class="row g-2 mt-2">
                <input type="hidden" name="_method" value="PUT" />
                <div class="col-md-3"><input class="form-control" name="businessName" value="${escapeHtml(supplier.businessName)}" maxlength="150" required /></div>
                <div class="col-md-2"><input class="form-control" name="taxId" value="${escapeHtml(supplier.taxId || '')}" maxlength="30" /></div>
                <div class="col-md-2"><input class="form-control" type="email" name="email" value="${escapeHtml(supplier.email || '')}" maxlength="120" /></div>
                <div class="col-md-2"><input class="form-control" name="phone" value="${escapeHtml(supplier.phone || '')}" maxlength="30" /></div>
                <div class="col-md-2"><input class="form-control" name="address" value="${escapeHtml(supplier.address || '')}" maxlength="200" /></div>
                <div class="col-md-1"><button class="btn btn-sm btn-light" type="submit">Guardar</button></div>
              </form>
            </details>
            <form class="mt-2" method="post" action="/catalogo/proveedores/${id}/estado">
              <input type="hidden" name="_method" value="PATCH" /><input type="hidden" name="isActive" value="${supplier.isActive ? 'false' : 'true'}" />
              <button class="btn btn-sm btn-outline-warning" type="submit">${supplier.isActive ? 'Desactivar' : 'Reactivar'}</button>
            </form></td></tr>`;
        }).join('')}</tbody>
      </table></div>
    </section>
  `
}) %>
